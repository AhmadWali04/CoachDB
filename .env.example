# Copy to backend/.env and fill in. Never commit real values.

# MongoDB Atlas (free M0 cluster is fine for the MVP)
MONGODB_URI=
MONGODB_DATABASE=rival_coaches

# LLM used by the coach agents
LLM_PROVIDER=
LLM_API_KEY=

# ElevenLabs (optional: the match runs with text-only briefings if unset)
ELEVENLABS_API_KEY=
ELEVENLABS_BLUE_VOICE_ID=
ELEVENLABS_RED_VOICE_ID=

# Frontend dev server origin(s) allowed by the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
